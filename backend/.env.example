# Chat model — OpenRouter (https://openrouter.ai). Required.
# Default is a free reasoning + tool-calling model. A reasoning model streams
# chain-of-thought to the thinking panel; a non-reasoning one shows nothing.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# OpenRouter falls back to this model (native routing) if the primary errors or
# is rate-limited. Free by default; leave empty to disable fallback.
OPENROUTER_FALLBACK_MODEL=openai/gpt-oss-120b:free
CORS_ORIGINS=*

# Build-time only: PageIndex index generation (scripts/build_index.py) calls
# Groq via litellm, which reads this from the environment. Not used at runtime.
# GROQ_API_KEY=

# Email notifications (optional) — uses Resend (https://resend.com)
EMAIL_NOTIFICATIONS_ENABLED=false
RESEND_API_KEY=
NOTIFY_EMAIL=dhirajpodar@gmail.com
NOTIFY_FROM=Portfolio Bot <noreply@dhirajpoddar.com>

# Visitor geo-IP enrichment for notifications (optional) — https://ipinfo.io/signup
# Works without a token at a lower quota. Free token = 50k lookups/month.
IPINFO_TOKEN=
