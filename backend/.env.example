GEMINI_API_KEY=
GROQ_API_KEY=
# Optional paid fallback used after Gemini + Groq are exhausted/rate-limited.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
MODEL_NAME=gemini-2.5-flash-lite
CORS_ORIGINS=*

# Email notifications (optional) — uses Resend (https://resend.com)
EMAIL_NOTIFICATIONS_ENABLED=false
RESEND_API_KEY=
NOTIFY_EMAIL=dhirajpodar@gmail.com
NOTIFY_FROM=Portfolio Bot <noreply@dhirajpoddar.com>

# Visitor geo-IP enrichment for notifications (optional) — https://ipinfo.io/signup
# Works without a token at a lower quota. Free token = 50k lookups/month.
IPINFO_TOKEN=
